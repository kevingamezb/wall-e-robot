{
    // Suite de pruebas del proyecto: pytest (ver tests/ y pytest.ini).
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    // Ayuda a Pylance a resolver el paquete 'app' desde la raíz del proyecto.
    "python.analysis.extraPaths": [
        "."
    ],
    // 'basic' (por defecto de Pylance): señala errores reales sin exigir
    // anotaciones de tipo en todo el código. 'off' lo desactiva del todo.
    "python.analysis.typeCheckingMode": "basic",
    "python-envs.defaultEnvManager": "ms-python.python:system"
}
